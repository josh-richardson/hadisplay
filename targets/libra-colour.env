# Kobo Libra Colour (N428, device code 390, "Monza", Mark 13 / MediaTek MT8110).
#
# Verified working on firmware 4.46.23836 with the existing mediatek-hwtcon code path --
# no source changes were needed, only this target file.
#
# Probed device facts (fbink -e, /proc, /sys):
#   deviceName='Libra Colour'  deviceId=390  deviceCodename='Monza'  devicePlatform='Mark 13'
#   isMTK=1  hasColorPanel=1  FBID='hwtcon'  1264x1680 @32bpp RGBA  currentRota=3  DPI=300
#   touchSwapAxes=1  touchMirrorY=1   (Elan Touchscreen on event1, gpio-keys on event0)
#   SoC MediaTek MT8110, 2 cores, 965MB RAM, glibc 2.19, kernel 4.9.77
#
# Two divergences from clara-colour.env that matter on this device:
#
#   1. $PLATFORM is the stale value "freescale" on this firmware even though the SoC is
#      MediaTek, so "/drivers/${PLATFORM}/wifi" resolves to a nonexistent path. The real
#      driver directory is /drivers/mt8113t-ntx/wifi, hardcoded below.
#   2. Wifi is the MediaTek gen4m stack (wlan_drv_gen4m / wmt_drv / wmt_chrdev_wifi), not
#      the i.MX6 sdio_wifi_pwr module, so the module-reload keepalive does not apply.
#      run-hadisplay.sh already handles wlan_drv_gen4m teardown (POWER_TOGGLE=wmt).

HADISPLAY_TARGET_NAME="libra-colour"
HADISPLAY_SSH_HOST="kobo-libra"
HADISPLAY_DEVICE_LABEL="Kobo Libra Colour"
HADISPLAY_EXPECTED_DEVICE_CODE="390"
HADISPLAY_EXPECTED_MODEL="Kobo Libra Colour N428"
HADISPLAY_EXPECTED_FRAMEBUFFER="hwtcon"
HADISPLAY_EXPECTED_SCREEN="1264x1680"
HADISPLAY_REMOTE_DIR="/mnt/onboard/.adds/hadisplay"
HADISPLAY_REMOTE_LOG="/mnt/onboard/.adds/hadisplay/hadisplay.log"
HADISPLAY_APP_DIR="/mnt/onboard/.adds/hadisplay"
HADISPLAY_APP_BIN="hadisplay"
HADISPLAY_APP_LOG="log.txt"
HADISPLAY_LD_LIBRARY_PATH="/mnt/onboard/.niluje/usbnet/lib"
HADISPLAY_NICKEL_BIN="/usr/local/Kobo/nickel"
HADISPLAY_NICKEL_LD_LIBRARY_PATH="/usr/local/Kobo:/lib:/usr/lib"
HADISPLAY_WIFI_INTERFACE="wlan0"
HADISPLAY_WIFI_HELPER_DIR="/mnt/onboard/.adds/koreader"
HADISPLAY_DISABLE_WIFI_SCRIPT="/mnt/onboard/.adds/koreader/disable-wifi.sh"
HADISPLAY_ENABLE_WIFI_SCRIPT="/mnt/onboard/.adds/koreader/enable-wifi.sh"
HADISPLAY_OBTAIN_IP_SCRIPT="/mnt/onboard/.adds/koreader/obtain-ip.sh"
HADISPLAY_KEEPALIVE_RELOAD_MODULE="false"
HADISPLAY_KEEPALIVE_MODULE_ROOT="/drivers/mt8113t-ntx/wifi"
